# Copy to .env and fill in. Never commit .env.
# LLM_PROVIDER: anthropic | openai | gemini
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Leave LLM_MODEL empty for the default (anthropic: claude-haiku-4-5-20251001,
# openai: gpt-4o-mini, gemini: gemini-2.5-flash)
LLM_MODEL=

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=uk_guidance
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Max LLM requests per minute (Gemini free tier: 5). 0 = no limit
LLM_RPM=0
